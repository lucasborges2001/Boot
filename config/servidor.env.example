# Boot-only example for the private systemd EnvironmentFile:
# /home/tecnicosfivisa/servidor/config/boot/server.env
# Do not commit the populated server.env or copy legacy /opt configuration.
BOOT_SERVIDOR_ROOT=/home/tecnicosfivisa/servidor
BASE_DIR=/home/tecnicosfivisa/servidor/current/base
BOOT_REPORTS_DIR=/home/tecnicosfivisa/servidor/state/boot/reports
BOOT_LOCK_FILE=/home/tecnicosfivisa/servidor/state/boot/reports/.boot-report.lock
BOOT_TELEMETRY_ENABLED=true
BOOT_HISTORY_RETENTION_DAYS=30
BOOT_HISTORY_MAX_FILES=50000
BOOT_SEND_TELEGRAM=false
