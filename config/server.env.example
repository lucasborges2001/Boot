# Boot server configuration.
# Copy to /opt/boot-report/config/server.env or /etc/boot-report/boot-report.env.

BOOT_TELEMETRY_ENABLED=true
# BOOT_ENABLED remains a legacy alias while existing installations migrate.
BOOT_REPORTS_DIR=/var/lib/boot-report/reports
BOOT_HISTORY_RETENTION_DAYS=30
BOOT_HISTORY_MAX_FILES=50000

# Detailed collectors are allowlist-based. Do not commit production-specific values.
BOOT_FILESYSTEM_ALLOWLIST=/,/var
BOOT_FILESYSTEM_EXCLUDELIST=/proc,/sys,/dev,/run
BOOT_NETWORK_INTERFACE_ALLOWLIST=
BOOT_DISK_DEVICE_ALLOWLIST=
BOOT_CPU_SAMPLE_INTERVAL_SECONDS=0.2
BOOT_INCLUDE_LAN_IP=true

BOOT_SEND_TELEGRAM=true
BOOT_DISABLE_LOCK=false
BASE_DIR=/opt/base

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_DISABLE_NOTIFICATION=false
TELEGRAM_TIMEOUT_SECONDS=15
TELEGRAM_RETRY_ATTEMPTS=3
TELEGRAM_RETRY_SLEEP_SECONDS=2

# Legacy aliases supported by Base Telegram helpers.
BOT_TOKEN=
CHAT_ID=
